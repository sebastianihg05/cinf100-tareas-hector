# Copia este archivo como .env en la raíz (opcional: sin él se usan estos valores).
POSTGRES_USER=devhub
POSTGRES_PASSWORD=devhub
POSTGRES_DB=cinf100
POSTGRES_PORT=5432
# Puerto de Adminer (interfaz web de la base).
ADMINER_PORT=8080

# Contraseña de las cuentas de prueba del seed (dev.admin@unab.cl, etc.).
# Ponle una para poder iniciar sesión con ellas. Vacía = aleatoria (nadie puede entrar).
SEED_PASSWORD=
# false para no cargar los usuarios de prueba.
CARGAR_SEED=true

AI_API_KEY=replace_me
ENVIRONMENT=development
