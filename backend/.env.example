DATABASE_URL=postgresql://devhub:devhub@localhost:5432/cinf100

# Clave con la que se firman las sesiones (JWT). En desarrollo sirve cualquier texto largo.
JWT_SECRET=clave-solo-para-desarrollo-cambiar-en-produccion

# Dirección del frontend (Vite) autorizada a llamar a la API.
FRONTEND_ORIGIN=http://localhost:5173

# Configuración del servicio de correo
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario@ejemplo.com
SMTP_PASSWORD=contraseña_de_ejemplo
EMAIL_FROM=usuario@ejemplo.com
# GPS del conductor: clave de openrouteservice (https://openrouteservice.org/dev/#/signup) para calcular la ruta.
# Vacía = el mapa muestra la posición, pero no la ruta.
ORS_API_KEY=
