{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "API del Sistema de Gestión de Transportes Vans UNAB",
  "type": "commonjs",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
